<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 64-bit process on 64-bit Windows: no 2-4 GB address-space limit. -->
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LasLogs.Core\LasLogs.Core.csproj" />
    <!-- Plotting (allowed by the assignment). 2.1.2 has been stable since 2022; its PngExporter draws with GDI+
         (System.Drawing), so net48 needs no native binaries. -->
    <PackageReference Include="OxyPlot.WindowsForms" Version="2.1.2" />
  </ItemGroup>
</Project>
